<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <Version>2.0.0</Version>
    <Authors>Athenex</Authors>
    <Company>Athenex</Company>
    <Copyright>Copyright © Athenex 2026</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/athene-x/Whimclean</PackageProjectUrl>
    <RepositoryUrl>https://github.com/athene-x/Whimclean.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>

    <!-- Embed PDBs in the assemblies so debugging and SourceLink work
         without a separate .snupkg symbol package. -->
    <DebugType>embedded</DebugType>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- 2.0 removes the Domain audit and soft-delete contracts on purpose
         (see docs/upgrading-to-2.0.md). 2.0.0 is also the first release on
         nuget.org, so from the first 2.x patch release set
         PackageValidationBaselineVersion to 2.0.0. -->

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Release builds map local source paths to /_/ so packages built on a
       developer machine are deterministic, the same as CI builds. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and '$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
