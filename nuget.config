<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Package validation restores the Athenex.Whimclean.* baseline packages
       from GitHub Packages; a PAT with read:packages must be configured for
       the "github" source at the user level (see the release runbook). -->
  <packageSources>
    <add key="github" value="https://nuget.pkg.github.com/athene-x/index.json" />
  </packageSources>

  <!-- All external dependencies of this repository resolve from nuget.org.
       Add a mapping here if a package must come from another feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Athenex.Whimclean.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
