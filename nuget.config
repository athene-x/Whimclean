<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- All dependencies of this repository, including the Athenex.Whimclean.*
       validation baselines, resolve from nuget.org. Add a mapping here if a
       package must come from another feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
