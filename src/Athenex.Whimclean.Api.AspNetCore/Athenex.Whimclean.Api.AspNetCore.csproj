<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Athenex Whimclean ASP.NET Core API</Product>
    <Title>Athenex Whimclean ASP.NET Core API</Title>
    <Description>Primary ASP.NET Core Minimal API package for Whimclean applications: Minimal API registration with OpenAPI, FluentValidation request validation and the list query contract, consistent exception, status-code, validation, and result error responses, plus claims-based current-user resolution for any authentication scheme. The FastEndpoints package adapts these conventions to FastEndpoints.</Description>
    <PackageTags>aspnetcore;minimal-api;api;openapi;validation;fluentvalidation;exception-handling;result;error-handling;problem-details;current-user;claims</PackageTags>
    <PackageReleaseNotes>2.0.0: hosts ListQueryParser (moved from Athenex.Whimclean.Application). Primary Minimal API package: AddMinimalApi and UseMinimalApi (error handling plus OpenAPI), MapApiGroup and WithRequestValidation (FluentValidation endpoint filter), validator registration from assemblies, the ListQueryRequest contract with its validator, the shared validation failure response, a consistent 400 body for empty bad-request responses, local user resolution, liveness and readiness endpoints, per-caller rate limiting, validated options, and the configuration placeholder marker.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Application/Athenex.Whimclean.Application.csproj" />
  </ItemGroup>

</Project>
