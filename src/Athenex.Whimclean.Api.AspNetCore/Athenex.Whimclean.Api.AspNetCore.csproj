<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Athenex Whimclean ASP.NET Core API</Product>
    <Title>Athenex Whimclean ASP.NET Core API</Title>
    <Description>Framework-neutral ASP.NET Core API conventions for Whimclean applications: consistent exception, status-code, and result error responses usable from FastEndpoints or Minimal APIs.</Description>
    <PackageTags>aspnetcore;api;exception-handling;result;error-handling;problem-details</PackageTags>
    <PackageReleaseNotes>Extracts the framework-neutral error contract, exception handling, status-code responses, and result mapping from the FastEndpoints package.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Application/Athenex.Whimclean.Application.csproj" />
  </ItemGroup>

</Project>
