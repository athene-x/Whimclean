<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Athenex Whimclean ASP.NET Core Identity Entity Framework Core</Product>
    <Title>Athenex Whimclean ASP.NET Core Identity Entity Framework Core</Title>
    <Description>Optional ASP.NET Core Identity and EF Core infrastructure for Whimclean applications, including a customizable authentication context and UserManager/SignInManager registration.</Description>
    <PackageTags>aspnetcore;identity;entity-framework-core;authentication;user-manager;sign-in-manager</PackageTags>
    <PackageReleaseNotes>Adds optional ASP.NET Core Identity EF storage with customizable context and UserManager/SignInManager registration.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Infrastructure.EntityFrameworkCore/Athenex.Whimclean.Infrastructure.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
