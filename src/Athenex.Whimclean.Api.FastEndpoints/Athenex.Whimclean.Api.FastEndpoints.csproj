<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Athenex Whimclean FastEndpoints API</Product>
    <Title>Athenex Whimclean FastEndpoints API</Title>
    <Description>FastEndpoints adapter for the primary Whimclean ASP.NET Core API package: endpoint registration, FastEndpoints OpenAPI, validation responses over the shared error contract, and whole-value binding of the shared list query filters.</Description>
    <PackageTags>fastendpoints;api;openapi;validation;exception-handling;result;error-handling</PackageTags>
    <PackageReleaseNotes>Thin adapter over Athenex.Whimclean.Api.AspNetCore: discovers validators derived from its ListQueryRequestValidator, renders validation failures through its shared mapper, applies whole-value binding of ListQueryRequest filters in UseFastEndpointsApi, and offers an AddFastEndpointsApi overload with an endpoint discovery hook.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Api.AspNetCore/Athenex.Whimclean.Api.AspNetCore.csproj" />
  </ItemGroup>

</Project>
