<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Athenex Whimclean Auditing ASP.NET Core</Product>
    <Title>Athenex Whimclean Auditing ASP.NET Core</Title>
    <Description>Supplies the audit log with what the current HTTP request knows about the caller: display name from the principal, correlation id, remote address and user agent.</Description>
    <PackageTags>auditing;audit-log;aspnetcore;correlation-id</PackageTags>
    <PackageReleaseNotes>First release: request-backed audit request context.</PackageReleaseNotes>

    <!-- First ships in 1.3.0; there is no earlier version to validate against. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Auditing/Athenex.Whimclean.Auditing.csproj" />
  </ItemGroup>

</Project>
