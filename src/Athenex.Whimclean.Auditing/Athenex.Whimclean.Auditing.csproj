<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Athenex Whimclean Auditing</Product>
    <Title>Athenex Whimclean Auditing</Title>
    <Description>Audit log for Whimclean applications: an audit entry entity, a Mediator pipeline behavior that records every audited command's outcome outside its unit of work, and a change collector fed by domain events.</Description>
    <PackageTags>auditing;audit-log;mediator;pipeline-behavior;compliance</PackageTags>
    <PackageReleaseNotes>First release: audited commands, outcome recording outside the unit of work, change collection from domain events, and the audit entry entity with its length limits.</PackageReleaseNotes>

    <!-- First ships in 1.3.0; there is no earlier version to validate against. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Application/Athenex.Whimclean.Application.csproj" />
    <ProjectReference Include="../Athenex.Whimclean.Domain/Athenex.Whimclean.Domain.csproj" />
  </ItemGroup>

</Project>
