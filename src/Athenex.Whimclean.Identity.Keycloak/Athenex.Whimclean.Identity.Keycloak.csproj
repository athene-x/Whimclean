<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Athenex Whimclean Keycloak Identity</Product>
    <Title>Athenex Whimclean Keycloak Identity</Title>
    <Description>Keycloak integration for Whimclean APIs: JWT bearer authentication with the claim conventions Keycloak tokens use, and an admin API client for provisioning users with a service account.</Description>
    <PackageTags>keycloak;authentication;jwt;oidc;identity;user-provisioning</PackageTags>
    <PackageReleaseNotes>First release: Keycloak JWT bearer registration and the admin user client.</PackageReleaseNotes>

    <!-- First ships in 1.3.0; there is no earlier version to validate against. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Domain/Athenex.Whimclean.Domain.csproj" />
  </ItemGroup>

</Project>
