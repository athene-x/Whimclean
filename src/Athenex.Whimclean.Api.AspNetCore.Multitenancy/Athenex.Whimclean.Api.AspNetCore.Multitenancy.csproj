<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Athenex Whimclean ASP.NET Core Multitenancy</Product>
    <Title>Athenex Whimclean ASP.NET Core Multitenancy</Title>
    <Description>Framework-neutral ASP.NET Core multitenancy integration with requested-tenant resolution, membership authorization, authorized tenant context, and API error mapping; works with FastEndpoints or Minimal APIs.</Description>
    <PackageTags>aspnetcore;multitenancy;tenant;authorization;middleware</PackageTags>
    <PackageReleaseNotes>2.0.0: first nuget.org release. Requested-tenant resolution from an id or slug header (through ITenantSlugLookup, id header taking precedence), membership authorization, and tenant API error mapping.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Api.AspNetCore/Athenex.Whimclean.Api.AspNetCore.csproj" />
    <ProjectReference Include="../Athenex.Whimclean.Multitenancy.Abstractions/Athenex.Whimclean.Multitenancy.Abstractions.csproj" />
  </ItemGroup>

</Project>
