<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Athenex.Whimclean.Infrastructure.AspNetCoreIdentity.EntityFrameworkCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>Athenex</Authors>
    <Company>Athenex</Company>
    <Copyright>Copyright © Athenex 2026</Copyright>
    <Product>Athenex Whimclean ASP.NET Core Identity Entity Framework Core</Product>
    <Title>Athenex Whimclean ASP.NET Core Identity Entity Framework Core</Title>
    <Description>Optional ASP.NET Core Identity and EF Core infrastructure for Whimclean applications, including a customizable authentication context and UserManager/SignInManager registration.</Description>
    <PackageTags>aspnetcore;identity;entity-framework-core;authentication;user-manager;sign-in-manager</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Adds optional ASP.NET Core Identity EF storage with customizable context and UserManager/SignInManager registration.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/athene-x/Whimclean</PackageProjectUrl>
    <RepositoryUrl>https://github.com/athene-x/Whimclean.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageOutputPath>../artifacts</PackageOutputPath>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Infrastructure.EntityFrameworkCore/Athenex.Whimclean.Infrastructure.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
