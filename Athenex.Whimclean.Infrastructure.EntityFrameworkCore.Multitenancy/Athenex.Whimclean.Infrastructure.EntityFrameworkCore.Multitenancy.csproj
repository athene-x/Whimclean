<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Athenex.Whimclean.Infrastructure.EntityFrameworkCore.Multitenancy</PackageId>
    <Version>0.1.0</Version>
    <Authors>Athenex</Authors>
    <Company>Athenex</Company>
    <Copyright>Copyright © Athenex 2026</Copyright>
    <Product>Athenex Whimclean Entity Framework Core Multitenancy</Product>
    <Title>Athenex Whimclean Entity Framework Core Multitenancy</Title>
    <Description>Optional provider-neutral EF Core multitenancy enforcement with fail-closed query filters and write validation.</Description>
    <PackageTags>entity-framework-core;multitenancy;tenant;query-filter;data-isolation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Adds optional provider-neutral EF Core tenant query filtering and fail-closed write validation.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/athene-x/Whimclean</PackageProjectUrl>
    <RepositoryUrl>https://github.com/athene-x/Whimclean.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageOutputPath>../artifacts</PackageOutputPath>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Infrastructure.EntityFrameworkCore/Athenex.Whimclean.Infrastructure.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../Athenex.Whimclean.Multitenancy.Abstractions/Athenex.Whimclean.Multitenancy.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
