<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Athenex.Whimclean.Infrastructure</PackageId>
    <Version>0.1.0</Version>
    <Authors>Athenex</Authors>
    <Company>Athenex</Company>
    <Copyright>Copyright © Athenex 2026</Copyright>
    <Product>Athenex Whimclean Infrastructure</Product>
    <Title>Athenex Whimclean Infrastructure</Title>
    <Description>Provider-neutral infrastructure building blocks for Whimclean applications, including audit actor resolution and asynchronous domain-event dispatch.</Description>
    <PackageTags>infrastructure;clean-architecture;auditing;domain-events</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Adds provider-neutral audit actor resolution and asynchronous domain-event dispatch contracts.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/athene-x/Whimclean</PackageProjectUrl>
    <RepositoryUrl>https://github.com/athene-x/Whimclean.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageOutputPath>../artifacts</PackageOutputPath>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Athenex.Whimclean.Domain/Athenex.Whimclean.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
